<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns colours and typography. This XML theme only prevents a white
      flash before the first Compose frame and keeps the bars transparent.
    -->
    <style name="Theme.Sairen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sairen_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
